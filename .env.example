# ===== 花妖远程操控台 · 本地环境配置模板 =====
# 使用方法: 复制本文件为 .env 并填入你的本地值
#   Windows(PowerShell):  Copy-Item .env.example .env
#   Unix/Linux/macOS:     cp .env.example .env
#
# 注意: .env 已被 .gitignore 排除, 不会进入版本库, 请勿提交任何真实凭证。

# ---- HTTP 服务 ----
# 监听端口(默认 13000)
PORT=13000
# 监听地址: 0.0.0.0=允许局域网访问(远程操控默认), 127.0.0.1=仅本机访问
HOST=0.0.0.0

# ---- AutoHotkey ----
# AHK 可执行文件完整路径(留空则自动探测常见安装位置)
AHK_EXE=

# ---- 花妖程序更新 ----
# 完整下载地址, {v} 会被替换为目标版本号。
# 请填写你自己的下载源:
#   例如 https://你的域名/你的路径/garden-v{v}-x64.zip
# 留空则更新功能不可用。
GARDEN_DOWNLOAD_URL=
# 解压/安装目录(相对项目根目录或绝对路径), 默认项目下 hua-yao/
GARDEN_INSTALL_DIR=hua-yao
# 解压后需要启动的主程序文件名, {v} 会被替换为目标版本号
GARDEN_EXE_NAME=garden-v{v}-x64.exe
