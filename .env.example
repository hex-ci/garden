# ===== 花妖远程操控台 · 本地环境配置模板 =====
# 使用方法: 复制本文件为 .env 并填入你的本地值
#   Windows(PowerShell):  Copy-Item .env.example .env
#   Unix/Linux/macOS:     cp .env.example .env
#
# 注意: .env 已被 .gitignore 排除, 不会进入版本库, 请勿提交任何真实凭证。

# ---- HTTP 服务 ----
# 监听端口(默认 13000)
PORT=13000
# 监听地址: 0.0.0.0=允许局域网访问(远程操控默认), 127.0.0.1=仅本机访问
HOST=127.0.0.1

# ---- AutoHotkey ----
# AHK 可执行文件完整路径(留空则自动探测常见安装位置)
AHK_EXE=
